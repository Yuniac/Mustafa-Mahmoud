---
import { readdirSync } from "node:fs";

// Count comes from disk — the legacy `imgCount = 9` is gone.
const count = readdirSync("public/img/lifestory/social-images").filter((f) =>
  /\.jpe?g$/i.test(f),
).length;
---

<section>
  <div class="carousel">
    <div>
      <img
        src="/img/Icons/backward.png"
        alt="icon"
        class="carousel-icon backward-icon"
      />
    </div>
    <div>
      <img
        src="/img/lifestory/social-images/img1.jpg"
        alt="صورة من المعرض"
        id="carouselImg"
        class="carousel-img"
        data-count={count}
      />
    </div>
    <div>
      <img
        src="/img/Icons/forward.png"
        alt="icon"
        class="carousel-icon forward-icon"
      />
    </div>
  </div>
</section>

<script>
  const base = "/img/lifestory/social-images/img";
  const ext = ".jpg";
  const carouselImg = document.querySelector<HTMLImageElement>("#carouselImg");
  const backwardImg = document.querySelector<HTMLElement>(".backward-icon");
  const forwardImg = document.querySelector<HTMLElement>(".forward-icon");

  if (carouselImg && backwardImg && forwardImg) {
    const imgCount = Number(carouselImg.dataset.count) || 1;
    let i = 1;

    const swap = () => {
      setTimeout(() => {
        carouselImg.src = `${base}${i}${ext}`;
      }, 650);
      carouselImg.style.opacity = "0";
      setTimeout(() => {
        carouselImg.style.opacity = "1";
      }, 750);
    };

    forwardImg.addEventListener("click", () => {
      i = i === imgCount ? 1 : i + 1;
      swap();
    });
    backwardImg.addEventListener("click", () => {
      if (i === 1) i = imgCount + 1;
      i--;
      swap();
    });
  }
</script>
