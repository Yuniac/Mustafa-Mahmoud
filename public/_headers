# Applied by Netlify (ignored by GitHub Pages).
# Interim caching: filenames are not content-hashed yet, so CSS/JS stay short.
# A future build step (Astro) will hash assets and allow immutable caching for them too.

/CSS/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/img/*
  Cache-Control: public, max-age=2592000

/videos/*
  Cache-Control: public, max-age=2592000

/*.css
  Cache-Control: public, max-age=3600, must-revalidate

/*.js
  Cache-Control: public, max-age=3600, must-revalidate
