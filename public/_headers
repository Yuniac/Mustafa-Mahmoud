# Applied by Netlify.

# Astro's content-hashed output (CSS, JS, optimized images) — safe to cache forever.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Fonts — stable filenames, content never changes.
/CSS/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# Un-hashed static assets in public/ (UI icons, banner, video).
/img/*
  Cache-Control: public, max-age=2592000
/videos/*
  Cache-Control: public, max-age=2592000
