---
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

const thumbs = import.meta.glob<{ default: ImageMetadata }>(
  "../assets/interviews/*.jpg",
  { eager: true },
);

const interviews = (await getCollection("interviews"))
  .map((e) => e.data)
  .sort((a, b) => a.id - b.id);
---

<div class="interviews-accordion accordion" id="accordion">
  {
    interviews.map((iv) => {
      const thumb = thumbs[`../assets/interviews/${iv.thumb}`]?.default;
      if (!thumb) throw new Error(`InterviewAccordion: missing thumb ${iv.thumb}`);
      return (
        <div class="interview-section">
          <div class="interview-title">
            <h2 class="accordion-heading">{iv.heading}</h2>
            <img
              src="/img/Icons/expand.png"
              alt="icon"
              class="expand-icon"
              width="48"
              height="48"
            />
          </div>
          <div class="interview-body">
            <div class="interview-description">
              <a href={iv.youtube} target="_blank" title={iv.linkTitle}>
                <Image
                  src={thumb}
                  alt={iv.thumbAlt}
                  class="interview-img"
                  width={304}
                  height={171}
                  loading="lazy"
                />
              </a>
              <p>{iv.description}</p>
            </div>
          </div>
        </div>
      );
    })
  }
</div>

<script>
  // De-hardcoded: was #expandIcon1..6 / .interview-body-1..6 wired one by one.
  document
    .querySelectorAll<HTMLElement>(".interviews-accordion .interview-section")
    .forEach((section) => {
      const header = section.querySelector<HTMLElement>(".interview-title");
      const icon = section.querySelector<HTMLElement>(".expand-icon");
      const body = section.querySelector<HTMLElement>(".interview-body");
      if (!header || !icon || !body) return;
      header.addEventListener("click", () => {
        if (body.style.visibility === "visible") {
          body.style.visibility = "hidden";
          body.style.maxHeight = "0px";
          icon.style.rotate = "0deg";
          setTimeout(() => {
            body.style.display = "none";
          }, 900);
        } else {
          body.style.display = "block";
          setTimeout(() => {
            body.style.visibility = "visible";
            body.style.maxHeight = "400px";
            icon.style.rotate = "180deg";
          }, 100);
        }
      });
    });
</script>
